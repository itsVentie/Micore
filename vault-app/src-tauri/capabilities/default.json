{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "core:path:default",
    "core:event:default",
    {
      "identifier": "core:image:allow-from-path",
      "allow": ["$APPDATA/**"]
    }
  ]
}